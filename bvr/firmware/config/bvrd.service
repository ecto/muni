[Unit]
Description=BVR Daemon - Base Vectoring Rover control
After=network.target can.service
Wants=network.target
Requires=can.service

[Service]
Type=simple
ExecStart=/usr/local/bin/bvrd --config /etc/bvr/bvr.toml
Restart=on-failure
RestartSec=3
User=root

# Environment
Environment=RUST_LOG=info
Environment=RUST_BACKTRACE=1
Environment=HOME=/root

# Resource limits
LimitNOFILE=65536

# Security - fully relaxed for hardware access and GStreamer
# ProtectHome=no is required for GStreamer to access registry cache in /root
ProtectSystem=false
ProtectHome=no
NoNewPrivileges=false
PrivateTmp=no
PrivateDevices=no

[Install]
WantedBy=multi-user.target



