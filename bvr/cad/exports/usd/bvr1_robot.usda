    def Xform "WheelFL" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        double3 xformOp:translate = (-280, 82, 280)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        float physics:mass = 2.0

        def PhysicsRevoluteJoint "WheelFLJoint"
        {
            rel physics:body0 = </BVR1/Body>
            rel physics:body1 = </BVR1/WheelFL>
            float3 physics:localPos0 = (-280, 82, 280)
            float3 physics:localPos1 = (0, 0, 0)
            float3 physics:axis = (1, 0, 0)

            float drive:angular:physics:damping = 10.0
            float drive:angular:physics:stiffness = 0.0
            float drive:angular:physics:maxForce = 50
            token drive:angular:physics:type = "force"
        }

