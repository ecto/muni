    {
      "id": 9,
      "title": "Point Cloud Latency",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 16 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "fieldConfig": {
