  "annotations": {
    "list": [
      {
        "name": "Hiccups",
        "datasource": { "type": "influxdb", "uid": "influxdb" },
        "enable": true,
        "iconColor": "red",
        "query": "from(bucket: \"muni\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"webrtc\" and r.rover == \"${rover}\")\n  |> filter(fn: (r) => r._field == \"telem_max_us\" or r._field == \"cloud_max_us\")\n  |> filter(fn: (r) => r._value > 5000)"
      }
    ]
  }
