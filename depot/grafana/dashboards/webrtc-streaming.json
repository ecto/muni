      "options": { "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"muni\")\n  |> range(start: -1m)\n  |> filter(fn: (r) => r._measurement == \"webrtc\" and r.rover == \"${rover}\" and r._field == \"video_sent\")\n  |> last()"
        }
