{
  "uid": "muni-rover-detail",
  "title": "Rover Detail",
  "tags": ["muni", "rover"],
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "rover",
        "type": "query",
        "datasource": { "type": "influxdb", "uid": "influxdb" },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"muni\", tag: \"rover\")",
        "refresh": 2,
        "current": { "text": "frog-0", "value": "frog-0" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Current Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "Disabled": { "text": "Disabled", "color": "dark-gray" } } },
            { "type": "value", "options": { "Idle": { "text": "Idle", "color": "blue" } } },
            { "type": "value", "options": { "Teleop": { "text": "Teleop", "color": "green" } } },
            { "type": "value", "options": { "Autonomous": { "text": "Auto", "color": "purple" } } },
            { "type": "value", "options": { "EStop": { "text": "E-Stop", "color": "red" } } }
          ]
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"muni\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"rover_status\" and r.rover == \"${rover}\" and r._field == \"mode\")\n  |> last()"
        }
      ]
    },
    {
      "id": 2,
      "title": "Battery Voltage",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "fieldConfig": {
        "defaults": {
          "unit": "volt",
          "min": 39,
          "max": 54,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 42 },
              { "color": "yellow", "value": 45 },
              { "color": "green", "value": 48 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"muni\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"rover_status\" and r.rover == \"${rover}\" and r._field == \"battery\")\n  |> last()"
        }
      ]
    },
    {
      "id": 3,
      "title": "System Current",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "fieldConfig": {
        "defaults": {
          "unit": "amp",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"muni\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"rover_status\" and r.rover == \"${rover}\" and r._field == \"current\")\n  |> last()"
        }
      ]
    },
    {
      "id": 4,
      "title": "Last Seen",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/_time/" } },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"muni\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"rover_status\" and r.rover == \"${rover}\" and r._field == \"battery\")\n  |> last()"
        }
      ]
    },
    {
      "id": 5,
      "title": "Battery Voltage Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "fieldConfig": {
        "defaults": {
          "unit": "volt",
          "min": 39,
          "max": 54,
          "custom": { "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"muni\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"rover_status\" and r.rover == \"${rover}\" and r._field == \"battery\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    },
    {
      "id": 6,
      "title": "Motor Temperatures",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 0,
          "max": 100,
          "custom": { "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"muni\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"motors\" and r.rover == \"${rover}\" and r._field == \"temp\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    },
    {
      "id": 7,
      "title": "Velocity (Commanded vs Actual)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "fieldConfig": {
        "defaults": {
          "unit": "velocityms",
          "custom": { "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"muni\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"velocity\" and r.rover == \"${rover}\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    },
    {
      "id": 8,
      "title": "Motor Currents",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "fieldConfig": {
        "defaults": {
          "unit": "amp",
          "custom": { "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"muni\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"motors\" and r.rover == \"${rover}\" and r._field == \"current\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    },
    {
      "id": 9,
      "title": "Mode Timeline",
      "type": "state-timeline",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "Disabled": { "text": "Disabled", "color": "dark-gray" } } },
            { "type": "value", "options": { "Idle": { "text": "Idle", "color": "blue" } } },
            { "type": "value", "options": { "Teleop": { "text": "Teleop", "color": "green" } } },
            { "type": "value", "options": { "Autonomous": { "text": "Auto", "color": "purple" } } },
            { "type": "value", "options": { "EStop": { "text": "E-Stop", "color": "red" } } }
          ]
        }
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "center"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"muni\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"rover_status\" and r.rover == \"${rover}\" and r._field == \"mode\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)"
        }
      ]
    },
    {
      "id": 10,
      "title": "Load Average (1m)",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 24 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 8,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 4 }
            ]
          }
        }
      },
      "options": { "showThresholdLabels": false, "showThresholdMarkers": true, "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"muni\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"system\" and r.rover == \"${rover}\" and r._field == \"load1\")\n  |> last()"
        }
      ]
    },
    {
      "id": 11,
      "title": "bvrd CPU",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 24 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 400,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 200 }
            ]
          }
        }
      },
      "options": { "showThresholdLabels": false, "showThresholdMarkers": true, "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"muni\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"system\" and r.rover == \"${rover}\" and r._field == \"process_cpu\")\n  |> last()"
        }
      ]
    },
    {
      "id": 12,
      "title": "Memory",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 24 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "options": { "showThresholdLabels": false, "showThresholdMarkers": true, "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"muni\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"system\" and r.rover == \"${rover}\" and r._field == \"mem\")\n  |> last()"
        }
      ]
    },
    {
      "id": 13,
      "title": "Disk",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 24 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "options": { "showThresholdLabels": false, "showThresholdMarkers": true, "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"muni\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"system\" and r.rover == \"${rover}\" and r._field == \"disk\")\n  |> last()"
        }
      ]
    },
    {
      "id": 14,
      "title": "CPU & Load Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "load1" },
            "properties": [{ "id": "displayName", "value": "Load (1m)" }]
          },
          {
            "matcher": { "id": "byName", "options": "load5" },
            "properties": [{ "id": "displayName", "value": "Load (5m)" }]
          },
          {
            "matcher": { "id": "byName", "options": "process_cpu" },
            "properties": [{ "id": "displayName", "value": "bvrd CPU %" }]
          },
          {
            "matcher": { "id": "byName", "options": "cpu" },
            "properties": [{ "id": "displayName", "value": "System CPU %" }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"muni\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"system\" and r.rover == \"${rover}\" and (r._field == \"load1\" or r._field == \"load5\" or r._field == \"process_cpu\" or r._field == \"cpu\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    },
    {
      "id": 15,
      "title": "Memory & Disk Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "fillOpacity": 10 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "mem" },
            "properties": [{ "id": "displayName", "value": "Memory %" }]
          },
          {
            "matcher": { "id": "byName", "options": "disk" },
            "properties": [{ "id": "displayName", "value": "Disk %" }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"muni\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"system\" and r.rover == \"${rover}\" and (r._field == \"mem\" or r._field == \"disk\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ]
    }
  ]
}
