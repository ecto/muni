---
interface Props {
  label: string;
  easing: string;
  duration?: string;
}

const { label, easing, duration = "300ms" } = Astro.props;
---

<div class="demo" data-easing={easing} data-duration={duration}>
  <div class="meta">
    <span class="label">{label}</span>
    <code class="value">{easing}</code>
  </div>
  <div class="track">
    <div
      class="dot"
      style={`transition: transform ${duration} ${easing};`}
    >
    </div>
  </div>
</div>

<style>
  .demo {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    border: 1px solid var(--border);
    cursor: pointer;
    user-select: none;
  }
  .demo:hover .dot {
    transform: translateX(calc(100cqi - 16px));
  }
  .meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .label {
    font-size: 12px;
    font-weight: 700;
  }
  .value {
    font-size: 10px;
    color: var(--fg-muted);
  }
  .track {
    height: 2px;
    background: var(--border);
    position: relative;
    container-type: inline-size;
  }
  .dot {
    position: absolute;
    top: -7px;
    left: 0;
    width: 16px;
    height: 16px;
    background: var(--primary);
    transform: translateX(0);
  }
</style>
