---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="demo">
  <div class="header">
    <span class="label">{label}</span>
  </div>
  <div class="canvas">
    <slot />
  </div>
</div>

<style>
  .demo {
    border: 1px solid var(--border);
  }
  .header {
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .canvas {
    padding: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }
</style>
