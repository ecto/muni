---
import Base from "../layouts/Base.astro";
---

<Base title="Identity">
  <div class="page-header">
    <p class="overline">Brand</p>
    <h1>Identity</h1>
    <p class="desc">
      Civic infrastructure, not consumer product. The identity signals service,
      transparency, and mechanical precision. Safety orange on black.
    </p>
  </div>

  <section>
    <h2 class="section-title">Logo</h2>
    <p class="section-desc">
      A continuous stroke that spells muni — the letters flow into each other,
      m into u into n into i, with a single dot. One unbroken line, like
      a sidewalk.
    </p>
    <div class="logo-grid">
      <div class="logo-card logo-on-dark">
        <img src="/muni-logo-dark.svg" alt="Muni logo on dark" class="logo-img" />
        <span class="logo-meta">On dark — safety orange, primary usage</span>
      </div>
      <div class="logo-card logo-on-light">
        <img src="/muni-logo-light.svg" alt="Muni logo on light" class="logo-img" />
        <span class="logo-meta">On light — black</span>
      </div>
      <div class="logo-card logo-on-orange">
        <img src="/muni-logo-light.svg" alt="Muni logo on orange" class="logo-img" />
        <span class="logo-meta">On orange — black, special contexts</span>
      </div>
    </div>

    <div class="logo-details">
      <div class="logo-detail">
        <span class="detail-label">Construction</span>
        <span class="detail-value">Single continuous stroke, 40px weight, round caps and joins</span>
      </div>
      <div class="logo-detail">
        <span class="detail-label">Dot</span>
        <span class="detail-value">28px radius circle on the i — the only discrete element</span>
      </div>
      <div class="logo-detail">
        <span class="detail-label">Clear space</span>
        <span class="detail-value">Minimum 60px (viewBox padding) on all sides</span>
      </div>
      <div class="logo-detail">
        <span class="detail-label">Minimum size</span>
        <span class="detail-value">48px height — below this the stroke weight collapses</span>
      </div>
      <div class="logo-detail">
        <span class="detail-label">Formats</span>
        <span class="detail-value">SVG (source), PNG exports at 1x/2x/4x</span>
      </div>
    </div>
  </section>

  <section>
    <h2 class="section-title">Logo Motion</h2>
    <p class="section-desc">
      The continuous stroke draws on left-to-right — a route being plotted.
      A cursor traces the leading edge. The dot on the 'i' settles last with
      spring overshoot. Total duration 2.4s at 30 fps (72 frames).
    </p>

    <div class="motion-viewport">
      <svg id="logo-motion" viewBox="-60 -80 880 420" fill="none">
        <defs>
          <filter id="glow">
            <feGaussianBlur stdDeviation="6" result="blur"/>
            <feMerge>
              <feMergeNode in="blur"/>
              <feMergeNode in="SourceGraphic"/>
            </feMerge>
          </filter>
        </defs>

        <g stroke="#ff6600" stroke-width="40" stroke-linecap="round" stroke-linejoin="round" fill="none">
          <path id="mpath-1" d="M 20 240 L 20 100 C 20 50, 80 50, 100 50 C 140 50, 160 70, 160 100"/>
          <path id="mpath-2" d="M 160 240 L 160 100"/>
          <path id="mpath-3" d="M 160 100 C 160 50, 220 50, 240 50 C 280 50, 300 70, 300 100 L 300 240 C 300 270, 330 280, 370 280 C 410 280, 440 270, 440 240 L 440 100"/>
          <path id="mpath-4" d="M 440 100 C 440 50, 500 50, 520 50 C 560 50, 600 70, 600 100 L 600 240 C 600 270, 630 280, 670 280 C 710 280, 740 270, 740 240 L 740 100"/>
        </g>

        <circle id="logo-dot" cx="740" cy="30" r="28" fill="#ff6600" transform="scale(0)" transform-origin="740 30"/>
        <circle id="cursor" cx="20" cy="240" r="10" fill="#ffffff" filter="url(#glow)" opacity="0"/>
      </svg>

      <div class="motion-bar">
        <div class="motion-bar-left">
          <button id="replay-btn" class="replay-btn">Replay</button>
          <button id="sound-btn" class="replay-btn sound-btn">Sound</button>
        </div>
        <span class="motion-timer" id="motion-timer">0.00s</span>
      </div>
    </div>

    <div class="timing-table">
      <div class="timing-header">
        <span>Element</span>
        <span>Start</span>
        <span>End</span>
        <span>Easing</span>
      </div>
      <div class="timing-row">
        <span class="timing-element">'m' left stem</span>
        <span class="timing-val">0.00s</span>
        <span class="timing-val">0.40s</span>
        <span class="timing-ease">ease-in-out</span>
      </div>
      <div class="timing-row">
        <span class="timing-element">'m' middle stem</span>
        <span class="timing-val">0.30s</span>
        <span class="timing-val">0.55s</span>
        <span class="timing-ease">ease-in-out</span>
      </div>
      <div class="timing-row">
        <span class="timing-element">'m' arch → 'u' curve</span>
        <span class="timing-val">0.45s</span>
        <span class="timing-val">1.40s</span>
        <span class="timing-ease">ease-in-out</span>
      </div>
      <div class="timing-row">
        <span class="timing-element">'n' arch → 'i' stem</span>
        <span class="timing-val">1.30s</span>
        <span class="timing-val">2.00s</span>
        <span class="timing-ease">ease-in-out</span>
      </div>
      <div class="timing-row">
        <span class="timing-element timing-dot">dot</span>
        <span class="timing-val">2.00s</span>
        <span class="timing-val">2.40s</span>
        <span class="timing-ease">spring (w14, d6) — restrained</span>
      </div>
      <div class="timing-row timing-audio-header">
        <span class="timing-element timing-audio-label">Audio</span>
        <span></span>
        <span></span>
        <span class="timing-ease">mote synth</span>
      </div>
      <div class="timing-row">
        <span class="timing-element timing-audio">trace — C3 root</span>
        <span class="timing-val">0.00s</span>
        <span class="timing-val">2.00s</span>
        <span class="timing-ease">130.81 Hz, formant 1.0×</span>
      </div>
      <div class="timing-row">
        <span class="timing-element timing-audio">trace — E3 third</span>
        <span class="timing-val">0.50s</span>
        <span class="timing-val">1.70s</span>
        <span class="timing-ease">164.81 Hz, formant 1.0×</span>
      </div>
      <div class="timing-row">
        <span class="timing-element timing-audio">trace — G3 fifth</span>
        <span class="timing-val">1.00s</span>
        <span class="timing-val">1.90s</span>
        <span class="timing-ease">196.00 Hz, formant 1.0×</span>
      </div>
      <div class="timing-row">
        <span class="timing-element timing-audio">dot — E4 bright</span>
        <span class="timing-val">2.00s</span>
        <span class="timing-val">2.35s</span>
        <span class="timing-ease">329.63 Hz, formant 1.5×</span>
      </div>
      <div class="timing-row">
        <span class="timing-element timing-audio">dot — C4 body</span>
        <span class="timing-val">2.01s</span>
        <span class="timing-val">2.41s</span>
        <span class="timing-ease">261.63 Hz, formant 1.2×</span>
      </div>
      <div class="timing-row">
        <span class="timing-element timing-audio">dot — G3 ring</span>
        <span class="timing-val">2.02s</span>
        <span class="timing-val">2.47s</span>
        <span class="timing-ease">196.00 Hz, formant 1.0×</span>
      </div>
    </div>

    <div class="remotion-note">
      <span class="remotion-label">Remotion</span>
      Map each path's <code>strokeDashoffset</code> from <code>totalLength → 0</code> using
      <code>interpolate(frame, [startFrame, endFrame], [length, 0])</code>.
      Dot uses <code>spring({'{'} stiffness: 196, damping: 12, mass: 1 {'}'})</code> on <code>scale</code> — restrained settle.
      Cursor position via <code>getPointAtLength()</code> on the active path.
    </div>
  </section>

  <section>
    <h2 class="section-title">Wordmark</h2>
    <div class="wordmark-grid">
      <div class="wordmark-card wordmark-dark">
        <span class="wordmark">muni</span>
        <span class="wordmark-meta">On dark — primary usage</span>
      </div>
      <div class="wordmark-card wordmark-light">
        <span class="wordmark">muni</span>
        <span class="wordmark-meta">On light</span>
      </div>
      <div class="wordmark-card wordmark-orange">
        <span class="wordmark">muni</span>
        <span class="wordmark-meta">On orange — special contexts</span>
      </div>
    </div>
  </section>

  <section>
    <h2 class="section-title">Lockup</h2>
    <div class="lockup-demo">
      <div class="lockup">
        <span class="lockup-name">muni</span>
        <span class="lockup-divider"></span>
        <span class="lockup-sub">Municipal Robotics</span>
      </div>
      <div class="lockup lockup-sm">
        <span class="lockup-name">muni</span>
        <span class="lockup-divider"></span>
        <span class="lockup-sub">Depot Console</span>
      </div>
      <div class="lockup lockup-sm">
        <span class="lockup-name">muni</span>
        <span class="lockup-divider"></span>
        <span class="lockup-sub">Design System</span>
      </div>
    </div>
  </section>

  <section class="livery-section">
    <h2 class="section-title">Vehicle Livery</h2>
    <p class="section-desc">
      The rover is a tool, not a mascot. Slab-sided panels, standard fasteners,
      flat surfaces — designed for stamping at volume and field repair by any
      technician with a hex key.
    </p>

    <!-- ── Hero: Side profile ───────────────────────────────── -->
    <div class="livery-hero">
      <svg viewBox="0 0 880 440" fill="none" class="livery-svg">
        <defs>
          <pattern id="chevron" patternUnits="userSpaceOnUse" width="24" height="18" patternTransform="skewX(-15)">
            <rect width="24" height="18" fill="oklch(0.97 0 0)"/>
            <rect width="12" height="18" fill="oklch(0.15 0.01 49)"/>
          </pattern>
          <linearGradient id="body-grad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="oklch(0.66 0.18 47)"/>
            <stop offset="100%" stop-color="oklch(0.63 0.17 47)"/>
          </linearGradient>
          <linearGradient id="canopy-grad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="oklch(0.68 0.18 47)"/>
            <stop offset="100%" stop-color="oklch(0.66 0.17 47)"/>
          </linearGradient>
          <filter id="lcd-glow">
            <feGaussianBlur stdDeviation="2" result="b"/>
            <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
          <clipPath id="body-clip">
            <rect x="225" y="175" width="410" height="164" rx="4"/>
          </clipPath>
        </defs>

        <!-- Ground plane -->
        <line x1="180" y1="396" x2="680" y2="396" stroke="oklch(0.20 0.005 49)" stroke-width="0.5"/>

        <!-- ── Wheels — 8.5" / 216 mm, hub bolts ── -->
        <!-- Front wheel -->
        <circle cx="274" cy="307" r="89" fill="oklch(0.14 0.005 49)"/>
        <circle cx="274" cy="307" r="73" fill="oklch(0.18 0.006 49)"/>
        <circle cx="274" cy="307" r="24" fill="oklch(0.22 0.008 55)"/>
        <circle cx="274" cy="307" r="6" fill="oklch(0.14 0.005 49)"/>
        <circle cx="262" cy="297" r="2.5" fill="oklch(0.28 0.008 55)"/>
        <circle cx="274" cy="291" r="2.5" fill="oklch(0.28 0.008 55)"/>
        <circle cx="286" cy="297" r="2.5" fill="oklch(0.28 0.008 55)"/>
        <circle cx="286" cy="317" r="2.5" fill="oklch(0.28 0.008 55)"/>
        <circle cx="274" cy="323" r="2.5" fill="oklch(0.28 0.008 55)"/>
        <circle cx="262" cy="317" r="2.5" fill="oklch(0.28 0.008 55)"/>
        <!-- Rear wheel -->
        <circle cx="586" cy="307" r="89" fill="oklch(0.14 0.005 49)"/>
        <circle cx="586" cy="307" r="73" fill="oklch(0.18 0.006 49)"/>
        <circle cx="586" cy="307" r="24" fill="oklch(0.22 0.008 55)"/>
        <circle cx="586" cy="307" r="6" fill="oklch(0.14 0.005 49)"/>
        <circle cx="574" cy="297" r="2.5" fill="oklch(0.28 0.008 55)"/>
        <circle cx="586" cy="291" r="2.5" fill="oklch(0.28 0.008 55)"/>
        <circle cx="598" cy="297" r="2.5" fill="oklch(0.28 0.008 55)"/>
        <circle cx="598" cy="317" r="2.5" fill="oklch(0.28 0.008 55)"/>
        <circle cx="586" cy="323" r="2.5" fill="oklch(0.28 0.008 55)"/>
        <circle cx="574" cy="317" r="2.5" fill="oklch(0.28 0.008 55)"/>

        <!-- ── Suspension A-arms (independent) ── -->
        <line x1="245" y1="339" x2="274" y2="316" stroke="oklch(0.22 0.005 49)" stroke-width="3" stroke-linecap="round"/>
        <line x1="303" y1="339" x2="274" y2="316" stroke="oklch(0.22 0.005 49)" stroke-width="3" stroke-linecap="round"/>
        <line x1="557" y1="339" x2="586" y2="316" stroke="oklch(0.22 0.005 49)" stroke-width="3" stroke-linecap="round"/>
        <line x1="615" y1="339" x2="586" y2="316" stroke="oklch(0.22 0.005 49)" stroke-width="3" stroke-linecap="round"/>

        <!-- ── Main body — 500 mm × 200 mm slab ── -->
        <rect x="225" y="175" width="410" height="164" rx="4" fill="url(#body-grad)"/>

        <!-- Panel seam + fasteners -->
        <line x1="232" y1="268" x2="630" y2="268" stroke="oklch(0.58 0.16 47)" stroke-width="0.75"/>
        <circle cx="260" cy="268" r="1.5" fill="oklch(0.52 0.13 47)"/>
        <circle cx="340" cy="268" r="1.5" fill="oklch(0.52 0.13 47)"/>
        <circle cx="430" cy="268" r="1.5" fill="oklch(0.52 0.13 47)"/>
        <circle cx="520" cy="268" r="1.5" fill="oklch(0.52 0.13 47)"/>
        <circle cx="610" cy="268" r="1.5" fill="oklch(0.52 0.13 47)"/>

        <!-- ── Canopy — flat top ── -->
        <rect x="248" y="142" width="364" height="33" rx="4" fill="url(#canopy-grad)"/>

        <!-- ── Sensor housing ── -->
        <rect x="385" y="130" width="90" height="12" rx="3" fill="oklch(0.55 0.15 47)" stroke="oklch(0.50 0.14 47)" stroke-width="0.75"/>
        <rect x="398" y="128" width="64" height="6" rx="2" fill="oklch(0.45 0.12 47 / 0.6)"/>

        <!-- ── Light bar ── -->
        <rect x="248" y="173" width="364" height="4" rx="2" fill="oklch(0.80 0.15 70)" opacity="0.85"/>
        <rect x="248" y="173" width="364" height="4" rx="2" fill="oklch(0.80 0.15 70 / 0.25)" class="light-bar-glow"/>

        <!-- ── Camera pod ── -->
        <rect x="213" y="196" width="18" height="50" rx="4" fill="oklch(0.52 0.15 47)" stroke="oklch(0.45 0.13 47)" stroke-width="1"/>
        <circle cx="222" cy="213" r="6" fill="oklch(0.20 0.005 240)" stroke="oklch(0.35 0.010 240)" stroke-width="0.75"/>
        <circle cx="222" cy="213" r="2.5" fill="oklch(0.10 0 0)"/>
        <circle cx="222" cy="233" r="6" fill="oklch(0.20 0.005 240)" stroke="oklch(0.35 0.010 240)" stroke-width="0.75"/>
        <circle cx="222" cy="233" r="2.5" fill="oklch(0.10 0 0)"/>

        <!-- ── Cooling vent ── -->
        <line x1="580" y1="185" x2="622" y2="185" stroke="oklch(0.55 0.14 47)" stroke-width="1"/>
        <line x1="580" y1="191" x2="622" y2="191" stroke="oklch(0.55 0.14 47)" stroke-width="1"/>
        <line x1="580" y1="197" x2="622" y2="197" stroke="oklch(0.55 0.14 47)" stroke-width="1"/>
        <line x1="580" y1="203" x2="622" y2="203" stroke="oklch(0.55 0.14 47)" stroke-width="1"/>

        <!-- ── Chevron band ── -->
        <rect x="225" y="326" width="410" height="12" fill="url(#chevron)" clip-path="url(#body-clip)"/>

        <!-- ── Tool mount ── -->
        <path d="M 215,280 L 215,332 C 215,336 219,339 222,339 L 225,339 L 225,280 Z" fill="none" stroke="oklch(0.50 0.14 47)" stroke-width="1" stroke-dasharray="4 3"/>

        <!-- ══════ BODY MARKINGS ══════ -->

        <!-- Logo mark -->
        <g transform="translate(246, 179) scale(0.022)" stroke="oklch(0.98 0 0)" stroke-width="40" stroke-linecap="round" stroke-linejoin="round" fill="none">
          <path d="M 20 240 L 20 100 C 20 50, 80 50, 100 50 C 140 50, 160 70, 160 100"/>
          <path d="M 160 240 L 160 100"/>
          <path d="M 160 100 C 160 50, 220 50, 240 50 C 280 50, 300 70, 300 100 L 300 240 C 300 270, 330 280, 370 280 C 410 280, 440 270, 440 240 L 440 100"/>
          <path d="M 440 100 C 440 50, 500 50, 520 50 C 560 50, 600 70, 600 100 L 600 240 C 600 270, 630 280, 670 280 C 710 280, 740 270, 740 240 L 740 100"/>
          <circle cx="740" cy="30" r="28" fill="oklch(0.98 0 0)" stroke="none"/>
        </g>

        <!-- Purpose label -->
        <text x="248" y="192" font-family="Space Grotesk, var(--font-display)" font-size="7" font-weight="500" letter-spacing="0.14em" fill="oklch(0.98 0 0 / 0.8)">SIDEWALK SERVICE ROBOT</text>

        <!-- Unit ID — 80 mm cap height at 0.82 scale -->
        <text x="246" y="260" font-family="Space Grotesk, var(--font-display)" font-size="90" font-weight="700" letter-spacing="-0.02em" fill="oklch(0.98 0 0)">BEAVER-12</text>

        <!-- LCD panel — 5" IPS, realistic scale -->
        <rect x="244" y="274" width="90" height="46" rx="3" fill="oklch(0.12 0.005 240)" stroke="oklch(0.25 0.008 240)" stroke-width="0.75"/>
        <rect x="247" y="277" width="84" height="40" rx="2" fill="oklch(0.08 0.004 49)"/>
        <rect x="247" y="277" width="84" height="8" rx="2" fill="oklch(0.705 0.213 47.604)"/>
        <text x="254" y="284" font-family="Space Grotesk, var(--font-display)" font-size="5.5" font-weight="700" fill="oklch(0.98 0 0)">muni</text>
        <text x="257" y="298" font-family="var(--font-mono)" font-size="4.5" fill="oklch(0.75 0 0)">Clearing Snow</text>
        <text x="257" y="308" font-family="var(--font-mono)" font-size="3.5" fill="oklch(0.45 0 0)">311 · muni.city</text>

        <!-- 311 + footer -->
        <text x="248" y="322" font-family="var(--font-mono)" font-size="5" fill="oklch(0.98 0 0 / 0.5)" letter-spacing="0.06em">MUNICIPAL ROBOTICS</text>
        <text x="626" y="322" text-anchor="end" font-family="var(--font-mono)" font-size="5.5" font-weight="600" fill="oklch(0.98 0 0 / 0.6)">311</text>

        <!-- ══════ CALLOUT NUMBERS ══════ -->
        <!-- 1: Sensor housing -->
        <circle cx="430" cy="120" r="9" fill="none" stroke="oklch(0.705 0.213 47.604)" stroke-width="0.75"/>
        <text x="430" y="123" text-anchor="middle" font-family="var(--font-mono)" font-size="8" font-weight="600" fill="oklch(0.705 0.213 47.604)">1</text>
        <!-- 2: Light bar -->
        <circle cx="700" cy="168" r="9" fill="none" stroke="oklch(0.705 0.213 47.604)" stroke-width="0.75"/>
        <text x="700" y="171" text-anchor="middle" font-family="var(--font-mono)" font-size="8" font-weight="600" fill="oklch(0.705 0.213 47.604)">2</text>
        <line x1="691" y1="168" x2="638" y2="174" stroke="oklch(0.705 0.213 47.604 / 0.3)" stroke-width="0.5"/>
        <!-- 3: Brand + purpose -->
        <circle cx="700" cy="196" r="9" fill="none" stroke="oklch(0.705 0.213 47.604)" stroke-width="0.75"/>
        <text x="700" y="199" text-anchor="middle" font-family="var(--font-mono)" font-size="8" font-weight="600" fill="oklch(0.705 0.213 47.604)">3</text>
        <line x1="691" y1="196" x2="638" y2="196" stroke="oklch(0.705 0.213 47.604 / 0.3)" stroke-width="0.5"/>
        <!-- 4: Unit ID -->
        <circle cx="700" cy="240" r="9" fill="none" stroke="oklch(0.705 0.213 47.604)" stroke-width="0.75"/>
        <text x="700" y="243" text-anchor="middle" font-family="var(--font-mono)" font-size="8" font-weight="600" fill="oklch(0.705 0.213 47.604)">4</text>
        <line x1="691" y1="240" x2="638" y2="240" stroke="oklch(0.705 0.213 47.604 / 0.3)" stroke-width="0.5"/>
        <!-- 5: LCD -->
        <circle cx="700" cy="290" r="9" fill="none" stroke="oklch(0.705 0.213 47.604)" stroke-width="0.75"/>
        <text x="700" y="293" text-anchor="middle" font-family="var(--font-mono)" font-size="8" font-weight="600" fill="oklch(0.705 0.213 47.604)">5</text>
        <line x1="691" y1="290" x2="338" y2="290" stroke="oklch(0.705 0.213 47.604 / 0.3)" stroke-width="0.5"/>
        <!-- 6: Chevron -->
        <circle cx="700" cy="332" r="9" fill="none" stroke="oklch(0.705 0.213 47.604)" stroke-width="0.75"/>
        <text x="700" y="335" text-anchor="middle" font-family="var(--font-mono)" font-size="8" font-weight="600" fill="oklch(0.705 0.213 47.604)">6</text>
        <line x1="691" y1="332" x2="638" y2="332" stroke="oklch(0.705 0.213 47.604 / 0.3)" stroke-width="0.5"/>
        <!-- 7: Camera -->
        <circle cx="178" cy="222" r="9" fill="none" stroke="oklch(0.705 0.213 47.604)" stroke-width="0.75"/>
        <text x="178" y="225" text-anchor="middle" font-family="var(--font-mono)" font-size="8" font-weight="600" fill="oklch(0.705 0.213 47.604)">7</text>
        <line x1="187" y1="222" x2="213" y2="222" stroke="oklch(0.705 0.213 47.604 / 0.3)" stroke-width="0.5"/>

        <!-- ── Dimensions ── -->
        <!-- Width: 500 mm -->
