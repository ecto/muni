<script>
  import { renderSequence, playBuffer, type Segment } from "../lib/synth";

  // ── Logo draw-on animation ──────────────────────────────────
  // Matches Remotion timing: 2.4s total, 30fps = 72 frames

  const paths = [
    document.getElementById("mpath-1") as SVGPathElement,
    document.getElementById("mpath-2") as SVGPathElement,
    document.getElementById("mpath-3") as SVGPathElement,
    document.getElementById("mpath-4") as SVGPathElement,
  ];
  const dot = document.getElementById("logo-dot")!;
  const cursor = document.getElementById("cursor")!;
  const timer = document.getElementById("motion-timer")!;
  const replayBtn = document.getElementById("replay-btn")!;
  const soundBtn = document.getElementById("sound-btn")!;

  const lengths = paths.map((p) => p.getTotalLength());

  // Timeline (seconds) — p=path index, s=start, e=end
  const visualSegments = [
    { p: 0, s: 0.0, e: 0.4 },
    { p: 1, s: 0.3, e: 0.55 },
    { p: 2, s: 0.45, e: 1.4 },
    { p: 3, s: 1.3, e: 2.0 },
  ];
  const DOT_START = 2.0;
  const DOT_END = 2.4;
  const TOTAL = 2.6;

  // ── Logo sonic design (mote VocalParams) ────────────────────
  //
  // C major triad builds during trace, resolves on dot.
  // Root (C3) enters first, major third (E3) joins midway,
  // fifth (G3) completes the chord. Dot stamps the octave (C4).
  // All formant ratios near 1.0 — warm, civic, no shimmer.

  const LOGO_AUDIO: Segment[] = [
    // Trace — C3 root, holds through entire draw
    { params: { volume: 0.16, freqHz: 130.81, formantRatio: 1.0, brightness: 0.0, attack: 0.1, sweepOctaves: 0.0 }, ms: 2000, delayMs: 0 },
    // Trace — E3 major third, enters midway
    { params: { volume: 0.12, freqHz: 164.81, formantRatio: 1.0, brightness: 0.0, attack: 0.1, sweepOctaves: 0.0 }, ms: 1200, delayMs: 500 },
    // Trace — G3 fifth, completes the triad
    { params: { volume: 0.10, freqHz: 196.00, formantRatio: 1.0, brightness: 0.0, attack: 0.1, sweepOctaves: 0.0 }, ms: 900, delayMs: 1000 },
    // Dot — E4 bright major third, the closing note
    { params: { volume: 0.30, freqHz: 329.63, formantRatio: 1.5, brightness: 0.0, attack: 0.8, sweepOctaves: 0.0 }, ms: 350, delayMs: 2000 },
    // Dot — C4 octave underneath for body
    { params: { volume: 0.18, freqHz: 261.63, formantRatio: 1.2, brightness: 0.0, attack: 0.6, sweepOctaves: 0.0 }, ms: 400, delayMs: 2010 },
    // Dot — G3 fifth sustain, lets the chord ring
    { params: { volume: 0.08, freqHz: 196.00, formantRatio: 1.0, brightness: 0.0, attack: 0.3, sweepOctaves: 0.0 }, ms: 450, delayMs: 2020 },
  ];

  let soundEnabled = false;
  let audioCtx: AudioContext | null = null;

  soundBtn.addEventListener("click", () => {
    soundEnabled = !soundEnabled;
    soundBtn.classList.toggle("active", soundEnabled);
    if (soundEnabled && !audioCtx) {
      audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
    }
  });

  function playLogoAudio() {
    if (!soundEnabled || !audioCtx) return;
    if (audioCtx.state === "suspended") audioCtx.resume();
    playBuffer(audioCtx, renderSequence(LOGO_AUDIO));
  }

  // ── Visual animation ────────────────────────────────────────

  function easeInOut(t: number) {
    return t < 0.5
      ? 4 * t * t * t
      : 1 - Math.pow(-2 * t + 2, 3) / 2;
  }

  function spring(t: number) {
    // Restrained settle — small overshoot, heavy damping
    const w = 14;
    const d = 6;
    return 1 - Math.exp(-d * t) * Math.cos(w * t);
  }

  function reset() {
    paths.forEach((p, i) => {
      p.style.strokeDasharray = `${lengths[i]}`;
      p.style.strokeDashoffset = `${lengths[i]}`;
    });
    dot.setAttribute("transform", "scale(0)");
    dot.setAttribute("transform-origin", "740 30");
    cursor.setAttribute("opacity", "0");
    timer.textContent = "0.00s";
  }

  function update(t: number) {
    timer.textContent = t.toFixed(2) + "s";

    let cursorVisible = false;
    let cursorX = 20;
    let cursorY = 240;

    for (const seg of visualSegments) {
      const idx = seg.p;
      const start = seg.s;
      const end = seg.e;
      const len = lengths[idx];

      if (t < start) {
        paths[idx].style.strokeDashoffset = `${len}`;
      } else if (t >= end) {
        paths[idx].style.strokeDashoffset = "0";
      } else {
        const progress = easeInOut((t - start) / (end - start));
        paths[idx].style.strokeDashoffset = `${len * (1 - progress)}`;

        const pt = paths[idx].getPointAtLength(progress * len);
        cursorX = pt.x;
        cursorY = pt.y;
        cursorVisible = true;
      }
    }

    if (t >= TOTAL * 0.85) {
      cursor.setAttribute("opacity", "0");
    } else if (cursorVisible) {
      cursor.setAttribute("cx", `${cursorX}`);
      cursor.setAttribute("cy", `${cursorY}`);
      cursor.setAttribute("opacity", "1");
    } else if (t > 0) {
      cursor.setAttribute("opacity", "0.5");
    }

    if (t >= DOT_START && t <= DOT_END) {
      const dt = (t - DOT_START) / (DOT_END - DOT_START);
      const sc = spring(dt);
      dot.setAttribute("transform", `translate(740, 30) scale(${sc}) translate(-740, -30)`);
    } else if (t > DOT_END) {
      dot.setAttribute("transform", "translate(740, 30) scale(1) translate(-740, -30)");
    }
  }

  let animStart = 0;
  let running = false;

  function play() {
    reset();
    running = true;
    animStart = performance.now();
    playLogoAudio();

    function tick(now: number) {
      const t = (now - animStart) / 1000;
      if (t > TOTAL) {
        update(TOTAL);
        running = false;
        return;
      }
      update(t);
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  replayBtn.addEventListener("click", play);

  // Auto-play on first view (visual only — sound requires interaction)
  const observer = new IntersectionObserver(
    (entries) => {
      if (entries[0].isIntersecting && !running) {
        play();
        observer.disconnect();
      }
    },
    { threshold: 0.5 },
  );
  observer.observe(document.getElementById("logo-motion")!);
</script>

