---
import Base from "../layouts/Base.astro";
import ComponentDemo from "../components/ComponentDemo.astro";
---

<Base title="Components">
  <div class="page-header">
    <p class="overline">Library</p>
    <h1>Components</h1>
    <p class="desc">
      React primitives built on shadcn/ui with muni tokens. Zero border radius.
      Terminal aesthetic. Every component earns its place.
    </p>
  </div>

  <!-- ═══ BUTTONS ════════════════════════════════════════════════ -->

  <section>
    <h2 class="section-title">Buttons</h2>
    <ComponentDemo label="Variants">
      <button class="btn btn-primary">Primary</button>
      <button class="btn btn-secondary">Secondary</button>
      <button class="btn btn-ghost">Ghost</button>
      <button class="btn btn-danger">E-Stop</button>
      <button class="btn btn-primary" disabled>Disabled</button>
    </ComponentDemo>
    <ComponentDemo label="Sizes">
      <button class="btn btn-primary btn-sm">Small</button>
      <button class="btn btn-primary">Default</button>
      <button class="btn btn-primary btn-lg">Large</button>
    </ComponentDemo>
    <ComponentDemo label="Icon Buttons">
      <button class="btn btn-primary btn-icon">+</button>
      <button class="btn btn-secondary btn-icon">×</button>
      <button class="btn btn-ghost btn-icon">⟲</button>
      <button class="btn btn-danger btn-icon">■</button>
    </ComponentDemo>
    <ComponentDemo label="Button Group">
      <div class="btn-group">
        <button class="btn btn-secondary btn-group-item active">Map</button>
        <button class="btn btn-secondary btn-group-item">Satellite</button>
        <button class="btn btn-secondary btn-group-item">Terrain</button>
      </div>
    </ComponentDemo>
  </section>

  <!-- ═══ BADGES ═════════════════════════════════════════════════ -->

  <section>
    <h2 class="section-title">Badges</h2>
    <ComponentDemo label="Rover Status">
      <span class="badge badge-active">active</span>
      <span class="badge badge-yield">yielding</span>
      <span class="badge badge-charge">charging</span>
      <span class="badge badge-off">offline</span>
      <span class="badge badge-maint">maintenance</span>
    </ComponentDemo>
    <ComponentDemo label="Priority">
      <span class="badge badge-critical">critical</span>
      <span class="badge badge-high">high</span>
      <span class="badge badge-normal">normal</span>
      <span class="badge badge-low">low</span>
    </ComponentDemo>
    <ComponentDemo label="Category">
      <span class="badge badge-cat">snow</span>
      <span class="badge badge-cat">leaves</span>
      <span class="badge badge-cat">patrol</span>
      <span class="badge badge-cat">delivery</span>
    </ComponentDemo>
  </section>

  <!-- ═══ STATUS INDICATORS ══════════════════════════════════════ -->

  <section>
    <h2 class="section-title">Status Indicators</h2>
    <ComponentDemo label="States">
      <div class="status">
        <span class="status-icon status-complete"></span>
        <span>Complete</span>
      </div>
      <div class="status">
        <span class="status-icon status-active"></span>
        <span>In Progress</span>
      </div>
      <div class="status">
        <span class="status-icon status-pending"></span>
        <span>Pending</span>
      </div>
      <div class="status">
        <span class="status-icon status-error"></span>
        <span>Error</span>
      </div>
      <div class="status">
        <span class="status-icon status-offline"></span>
        <span>Offline</span>
      </div>
    </ComponentDemo>
    <ComponentDemo label="Inline">
      <span class="status-inline"><span class="status-dot dot-green"></span> 3 online</span>
      <span class="status-inline"><span class="status-dot dot-orange"></span> 1 yielding</span>
      <span class="status-inline"><span class="status-dot dot-red"></span> E-stop</span>
      <span class="status-inline"><span class="status-dot dot-muted"></span> 1 offline</span>
    </ComponentDemo>
  </section>

  <!-- ═══ PROGRESS & DATA VIZ ════════════════════════════════════ -->

  <section>
    <h2 class="section-title">Progress &amp; Data Viz</h2>
    <ComponentDemo label="Progress Bars">
      <div class="progress-stack">
        <div class="progress-row">
          <span class="progress-label">Battery</span>
          <div class="progress-track"><div class="progress-fill fill-green" style="width: 73%"></div></div>
          <span class="progress-value">73%</span>
        </div>
        <div class="progress-row">
          <span class="progress-label">Route</span>
          <div class="progress-track"><div class="progress-fill fill-orange" style="width: 67%"></div></div>
          <span class="progress-value">67%</span>
        </div>
        <div class="progress-row">
          <span class="progress-label">Battery</span>
          <div class="progress-track"><div class="progress-fill fill-red" style="width: 12%"></div></div>
          <span class="progress-value">12%</span>
        </div>
        <div class="progress-row">
          <span class="progress-label">Coverage</span>
          <div class="progress-track"><div class="progress-fill fill-green" style="width: 100%"></div></div>
          <span class="progress-value">100%</span>
        </div>
      </div>
    </ComponentDemo>
    <ComponentDemo label="Sparklines">
      <div class="sparkline-group">
        <div class="sparkline-item">
          <span class="sparkline-label">Cleared / hr</span>
          <svg class="sparkline" viewBox="0 0 120 32">
            <polyline points="0,28 10,24 20,26 30,20 40,22 50,16 60,18 70,12 80,14 90,8 100,10 110,6 120,4" fill="none" stroke="oklch(0.705 0.213 47.604)" stroke-width="1.5"/>
          </svg>
          <span class="sparkline-val">2.4 km</span>
        </div>
        <div class="sparkline-item">
          <span class="sparkline-label">Energy / hr</span>
          <svg class="sparkline" viewBox="0 0 120 32">
            <polyline points="0,8 10,12 20,10 30,16 40,14 50,18 60,16 70,20 80,18 90,22 100,20 110,24 120,22" fill="none" stroke="oklch(0.723 0.191 149)" stroke-width="1.5"/>
          </svg>
          <span class="sparkline-val">1.2 kWh</span>
        </div>
        <div class="sparkline-item">
          <span class="sparkline-label">Interactions</span>
          <svg class="sparkline" viewBox="0 0 120 32">
            <polyline points="0,20 10,18 20,22 30,16 40,24 50,12 60,20 70,8 80,16 90,14 100,18 110,10 120,16" fill="none" stroke="oklch(0.546 0.215 264)" stroke-width="1.5"/>
          </svg>
          <span class="sparkline-val">23</span>
        </div>
      </div>
    </ComponentDemo>
  </section>

  <!-- ═══ CARDS ══════════════════════════════════════════════════ -->

  <section>
    <h2 class="section-title">Cards</h2>
    <ComponentDemo label="Rover Card">
      <div class="card">
        <div class="card-header">
          <span class="card-title">beaver-12</span>
          <span class="card-badge card-badge-active">operational</span>
        </div>
        <div class="card-body">
          <div class="card-row">
            <span class="card-label">Task</span>
            <span>Clearing snow — Oak St</span>
          </div>
          <div class="card-row">
            <span class="card-label">Battery</span>
            <span>73%</span>
          </div>
          <div class="card-row">
            <span class="card-label">Uptime</span>
            <span>4h 22m</span>
          </div>
        </div>
      </div>
    </ComponentDemo>
    <ComponentDemo label="Metric Cards">
      <div class="metric-card">
        <div class="metric-head">
          <span class="metric-label">Snow Cleared</span>
          <span class="metric-trend trend-up">+12%</span>
        </div>
        <span class="metric-value">2.4 km</span>
        <svg class="sparkline" viewBox="0 0 120 24">
          <polyline points="0,20 15,16 30,18 45,12 60,14 75,8 90,10 105,4 120,2" fill="none" stroke="oklch(0.705 0.213 47.604)" stroke-width="1.5"/>
        </svg>
      </div>
      <div class="metric-card">
        <div class="metric-head">
          <span class="metric-label">Fleet Availability</span>
        </div>
        <span class="metric-value">75%</span>
        <div class="metric-bar">
          <div class="metric-seg" style="width:50%; background: oklch(0.723 0.191 149)"></div>
          <div class="metric-seg" style="width:25%; background: oklch(0.546 0.215 264)"></div>
          <div class="metric-seg" style="width:25%; background: oklch(0.4 0 0)"></div>
        </div>
      </div>
      <div class="metric-card">
        <div class="metric-head">
          <span class="metric-label">Energy</span>
          <span class="metric-trend trend-down">-8%</span>
        </div>
        <span class="metric-value">1.2 kWh</span>
        <svg class="sparkline" viewBox="0 0 120 24">
          <polyline points="0,4 15,8 30,6 45,12 60,10 75,14 90,12 105,18 120,16" fill="none" stroke="oklch(0.723 0.191 149)" stroke-width="1.5"/>
        </svg>
      </div>
    </ComponentDemo>
  </section>

  <!-- ═══ DATA DISPLAY ═══════════════════════════════════════════ -->

  <section>
    <h2 class="section-title">Data Display</h2>
    <ComponentDemo label="Table">
      <table class="data-table">
        <thead>
          <tr>
            <th>Unit</th>
            <th>Status</th>
            <th>Battery</th>
            <th>Task</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>beaver-12</td>
            <td><span class="inline-status active"></span> Active</td>
            <td>73%</td>
            <td>Snow — Oak St</td>
          </tr>
          <tr>
            <td>beaver-07</td>
            <td><span class="inline-status yield"></span> Yielding</td>
            <td>45%</td>
            <td>Snow — Elm Ave</td>
          </tr>
          <tr>
            <td>beaver-03</td>
            <td><span class="inline-status offline"></span> Charging</td>
            <td>12%</td>
            <td>—</td>
          </tr>
        </tbody>
      </table>
    </ComponentDemo>
    <ComponentDemo label="Key-Value List">
      <div class="kv-list">
        <div class="kv-row"><span class="kv-key">Unit</span><span class="kv-val">beaver-12</span></div>
        <div class="kv-row"><span class="kv-key">Firmware</span><span class="kv-val">bvrd v0.8.2</span></div>
        <div class="kv-row"><span class="kv-key">Position</span><span class="kv-val">44.9778°N 93.2650°W</span></div>
        <div class="kv-row"><span class="kv-key">RTK</span><span class="kv-val">Fixed — 1.2 cm</span></div>
        <div class="kv-row"><span class="kv-key">CAN</span><span class="kv-val">5 devices · 24 ms</span></div>
      </div>
    </ComponentDemo>
  </section>

  <!-- ═══ TIMELINE ═══════════════════════════════════════════════ -->

  <section>
    <h2 class="section-title">Timeline</h2>
    <ComponentDemo label="Event Log">
      <div class="timeline">
        <div class="tl-entry">
          <span class="tl-time">14:32</span>
          <span class="tl-dot tl-dot-green"></span>
          <div class="tl-content">
            <span class="tl-msg">Route progress 67% — Oak St NW</span>
            <span class="tl-meta">beaver-12</span>
          </div>
        </div>
        <div class="tl-entry">
          <span class="tl-time">14:31</span>
          <span class="tl-dot tl-dot-orange"></span>
          <div class="tl-content">
            <span class="tl-msg">Battery below 50% threshold</span>
            <span class="tl-meta">beaver-07</span>
          </div>
        </div>
        <div class="tl-entry">
          <span class="tl-time">14:31</span>
          <span class="tl-dot tl-dot-blue"></span>
          <div class="tl-content">
            <span class="tl-msg">Returned to depot — bay 2</span>
            <span class="tl-meta">beaver-03</span>
          </div>
        </div>
        <div class="tl-entry">
          <span class="tl-time">14:31</span>
          <span class="tl-dot tl-dot-red"></span>
          <div class="tl-content">
            <span class="tl-msg">CAN bus timeout on vesc-3 (retry 2/3)</span>
            <span class="tl-meta">beaver-01</span>
          </div>
        </div>
        <div class="tl-entry">
          <span class="tl-time">14:31</span>
          <span class="tl-dot tl-dot-green"></span>
          <div class="tl-content">
            <span class="tl-msg">Pedestrian yield completed — 4.2s wait</span>
            <span class="tl-meta">beaver-12</span>
          </div>
        </div>
      </div>
    </ComponentDemo>
  </section>

  <!-- ═══ CALLOUTS ═══════════════════════════════════════════════ -->

  <section>
    <h2 class="section-title">Callouts</h2>
    <ComponentDemo label="Severity Levels">
      <div class="callouts">
        <div class="callout callout-danger">
          <div class="callout-title">Danger</div>
          <p>Emergency stop engaged. All rovers halted. Manual reset required.</p>
        </div>
        <div class="callout callout-warning">
          <div class="callout-title">Warning</div>
          <p>Battery below 20%. Rover returning to depot for charging.</p>
        </div>
        <div class="callout callout-info">
          <div class="callout-title">Note</div>
          <p>Firmware update available. Schedule during next maintenance window.</p>
        </div>
        <div class="callout callout-success">
          <div class="callout-title">Success</div>
          <p>Route completed. 2.4km cleared in 1h 12m. Returning to depot.</p>
        </div>
      </div>
    </ComponentDemo>
  </section>

  <!-- ═══ TOASTS ═════════════════════════════════════════════════ -->

  <section>
    <h2 class="section-title">Toast Notifications</h2>
    <ComponentDemo label="Variants">
      <div class="toast-stack">
        <div class="toast toast-success">
          <span class="toast-icon">✓</span>
          <span class="toast-msg">Deploy complete. frog-0 running bvrd v0.8.2</span>
          <button class="toast-close">×</button>
        </div>
        <div class="toast toast-warning">
          <span class="toast-icon">!</span>
          <span class="toast-msg">beaver-07 battery below 25%. Returning to depot.</span>
          <button class="toast-close">×</button>
        </div>
        <div class="toast toast-error">
          <span class="toast-icon">×</span>
          <span class="toast-msg">Connection lost to beaver-01. Last seen 2m ago.</span>
          <button class="toast-close">×</button>
        </div>
        <div class="toast toast-info">
          <span class="toast-icon">i</span>
          <span class="toast-msg">Firmware v0.8.3 available for 3 rovers.</span>
          <button class="toast-close">×</button>
        </div>
      </div>
    </ComponentDemo>
  </section>

  <!-- ═══ MODAL ══════════════════════════════════════════════════ -->

  <section>
    <h2 class="section-title">Modal / Dialog</h2>
    <ComponentDemo label="Confirmation">
      <div class="modal-demo">
        <div class="modal-box">
          <div class="modal-header">Confirm E-Stop</div>
          <div class="modal-body">
            <p>This will immediately halt all motors on <strong>beaver-12</strong>. The rover will stop in place and require manual reset.</p>
          </div>
          <div class="modal-footer">
            <button class="btn btn-ghost">Cancel</button>
            <button class="btn btn-danger">E-Stop</button>
          </div>
        </div>
      </div>
    </ComponentDemo>
    <ComponentDemo label="Info">
      <div class="modal-demo">
        <div class="modal-box">
          <div class="modal-header">Firmware Update</div>
          <div class="modal-body">
            <p>bvrd v0.8.3 is available. Changes:</p>
            <ul class="modal-list">
              <li>Fix: CAN bus timeout recovery</li>
              <li>Fix: GPS drift during RTK reacquisition</li>
              <li>New: Pedestrian detection confidence threshold</li>
            </ul>
          </div>
          <div class="modal-footer">
            <button class="btn btn-ghost">Later</button>
            <button class="btn btn-primary">Schedule Update</button>
          </div>
        </div>
      </div>
    </ComponentDemo>
  </section>

  <!-- ═══ INPUTS ═════════════════════════════════════════════════ -->

  <section>
    <h2 class="section-title">Inputs</h2>
    <ComponentDemo label="Text & Select">
      <div class="form-group">
        <label class="form-label">Unit ID</label>
        <input type="text" class="form-input" value="beaver-12" readonly />
      </div>
      <div class="form-group">
        <label class="form-label">Route</label>
        <select class="form-input">
          <option>Oak St — North</option>
          <option>Elm Ave — Full</option>
          <option>Main St — South</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Speed Limit</label>
        <input type="text" class="form-input" placeholder="0.8 m/s" />
      </div>
    </ComponentDemo>
    <ComponentDemo label="Toggle">
      <label class="toggle">
        <input type="checkbox" checked />
        <span class="toggle-track"><span class="toggle-thumb"></span></span>
        <span class="toggle-text">Autonomous mode</span>
      </label>
      <label class="toggle">
        <input type="checkbox" />
        <span class="toggle-track"><span class="toggle-thumb"></span></span>
        <span class="toggle-text">Headlights</span>
      </label>
      <label class="toggle">
        <input type="checkbox" checked />
        <span class="toggle-track"><span class="toggle-thumb"></span></span>
        <span class="toggle-text">Telemetry</span>
      </label>
    </ComponentDemo>
    <ComponentDemo label="Checkbox & Radio">
      <div class="check-group">
        <label class="check">
          <input type="checkbox" checked />
          <span class="check-box"></span>
          <span>Snow removal</span>
        </label>
        <label class="check">
          <input type="checkbox" checked />
          <span class="check-box"></span>
          <span>Leaf clearing</span>
        </label>
        <label class="check">
          <input type="checkbox" />
          <span class="check-box"></span>
          <span>Patrol</span>
        </label>
      </div>
      <div class="check-group">
        <label class="check">
          <input type="radio" name="mode" checked />
          <span class="radio-dot"></span>
          <span>Autonomous</span>
        </label>
        <label class="check">
          <input type="radio" name="mode" />
          <span class="radio-dot"></span>
          <span>Teleop</span>
        </label>
        <label class="check">
          <input type="radio" name="mode" />
          <span class="radio-dot"></span>
          <span>Idle</span>
        </label>
      </div>
    </ComponentDemo>
    <ComponentDemo label="Slider">
      <div class="slider-group">
        <div class="form-group">
          <label class="form-label">Speed limit</label>
          <div class="slider-wrap">
            <input type="range" class="slider" min="0" max="100" value="60" />
            <span class="slider-val">0.6 m/s</span>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Volume</label>
          <div class="slider-wrap">
            <input type="range" class="slider" min="0" max="100" value="35" />
            <span class="slider-val">35%</span>
          </div>
        </div>
      </div>
    </ComponentDemo>
  </section>

  <!-- ═══ NAVIGATION ═════════════════════════════════════════════ -->

  <section>
    <h2 class="section-title">Navigation</h2>
    <ComponentDemo label="Tabs">
      <div class="tab-bar">
        <button class="tab tab-active">Dashboard</button>
        <button class="tab">Fleet</button>
        <button class="tab">Dispatch</button>
        <button class="tab">Maps</button>
        <button class="tab">Metrics</button>
      </div>
    </ComponentDemo>
    <ComponentDemo label="Breadcrumbs">
      <nav class="breadcrumb">
        <a class="crumb" href="#">Depot</a>
        <span class="crumb-sep">/</span>
        <a class="crumb" href="#">Fleet</a>
        <span class="crumb-sep">/</span>
        <span class="crumb crumb-current">beaver-12</span>
      </nav>
    </ComponentDemo>
    <ComponentDemo label="Pagination">
      <nav class="pagination">
        <button class="page-btn" disabled>←</button>
        <button class="page-btn page-active">1</button>
        <button class="page-btn">2</button>
        <button class="page-btn">3</button>
        <span class="page-dots">…</span>
        <button class="page-btn">12</button>
        <button class="page-btn">→</button>
      </nav>
    </ComponentDemo>
  </section>

  <!-- ═══ KEYBOARD SHORTCUTS ═════════════════════════════════════ -->

  <section>
    <h2 class="section-title">Keyboard Shortcuts</h2>
    <ComponentDemo label="Key Combos">
      <div class="kbd-list">
        <div class="kbd-row"><div class="kbd-combo"><kbd>⌘</kbd><kbd>K</kbd></div><span class="kbd-desc">Command palette</span></div>
        <div class="kbd-row"><div class="kbd-combo"><kbd>⌘</kbd><kbd>⇧</kbd><kbd>E</kbd></div><span class="kbd-desc">E-stop all rovers</span></div>
        <div class="kbd-row"><div class="kbd-combo"><kbd>Space</kbd></div><span class="kbd-desc">Toggle selected rover</span></div>
        <div class="kbd-row"><div class="kbd-combo"><kbd>J</kbd> / <kbd>K</kbd></div><span class="kbd-desc">Navigate fleet list</span></div>
        <div class="kbd-row"><div class="kbd-combo"><kbd>M</kbd></div><span class="kbd-desc">Toggle map view</span></div>
        <div class="kbd-row"><div class="kbd-combo"><kbd>?</kbd></div><span class="kbd-desc">Show all shortcuts</span></div>
      </div>
    </ComponentDemo>
  </section>

  <!-- ═══ LOADING & EMPTY STATES ═════════════════════════════════ -->

  <section>
    <h2 class="section-title">Loading &amp; Empty States</h2>
    <ComponentDemo label="Spinners">
      <div class="spinner spin-sm"></div>
      <div class="spinner"></div>
      <div class="spinner spin-lg"></div>
    </ComponentDemo>
    <ComponentDemo label="Skeleton">
      <div class="skeleton-group">
        <div class="skeleton skel-line" style="width: 40%"></div>
        <div class="skeleton skel-line"></div>
        <div class="skeleton skel-line" style="width: 70%"></div>
        <div class="skeleton skel-block"></div>
      </div>
    </ComponentDemo>
    <ComponentDemo label="Empty State">
      <div class="empty-state">
        <span class="empty-icon">○</span>
        <span class="empty-title">No rovers connected</span>
        <span class="empty-desc">Rovers will appear here once they come online and register with the depot.</span>
        <button class="btn btn-secondary btn-sm">Scan network</button>
      </div>
    </ComponentDemo>
    <ComponentDemo label="Error State">
      <div class="empty-state empty-error">
        <span class="empty-icon">!</span>
        <span class="empty-title">Connection lost</span>
        <span class="empty-desc">Cannot reach the depot server. Check your network connection or VPN status.</span>
        <button class="btn btn-secondary btn-sm">Retry</button>
      </div>
    </ComponentDemo>
  </section>

  <!-- ═══ ROVER IDENTITY ═════════════════════════════════════════ -->

  <section>
    <h2 class="section-title">Rover Identity</h2>
    <ComponentDemo label="Unit Cards">
      <div class="rover-unit">
        <div class="rover-avatar"><span class="rover-dot dot-green"></span></div>
        <div class="rover-info">
          <span class="rover-name">beaver-12</span>
          <span class="rover-sub">Clearing snow — Oak St NW</span>
        </div>
        <span class="rover-batt">73%</span>
      </div>
      <div class="rover-unit">
