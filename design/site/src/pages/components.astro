  .progress-label { color: var(--fg-muted); min-width: 56px; font-size: 10px; text-transform: uppercase; letter-spacing: 0.04em; }
  .progress-track { flex: 1; height: 4px; background: var(--border); }
  .progress-fill { height: 100%; transition: width 300ms ease; }
  .fill-green { background: oklch(0.723 0.191 149); }
