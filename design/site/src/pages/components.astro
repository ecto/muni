<style>
  /* ═══════════════════════════════════════════════════════════════
     BUTTONS
     ═══════════════════════════════════════════════════════════════ */

  .btn {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    padding: 8px 16px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: background-color 100ms ease, color 100ms ease, border-color 100ms ease;
  }
  .btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .btn-primary { background: var(--primary); color: var(--black); }
  .btn-primary:hover:not(:disabled) { background: oklch(0.75 0.17 47.604); }
  .btn-secondary { background: transparent; color: var(--fg); border-color: var(--border); }
  .btn-secondary:hover { border-color: var(--fg); }
  .btn-ghost { background: transparent; color: var(--fg-muted); }
  .btn-ghost:hover { color: var(--fg); background: var(--surface); }
  .btn-danger { background: oklch(0.467 0.186 18.5); color: var(--white); }
  .btn-danger:hover { background: oklch(0.53 0.19 18.5); }
  .btn-sm { font-size: 11px; padding: 4px 12px; }
  .btn-lg { font-size: 14px; padding: 12px 24px; }
  .btn-icon { padding: 8px; min-width: 36px; text-align: center; }

  .btn-group { display: flex; }
  .btn-group .btn-group-item { border-right: none; }
  .btn-group .btn-group-item:last-child { border-right: 1px solid var(--border); }
  .btn-group .btn-group-item.active {
    background: var(--surface);
    color: var(--fg);
    border-color: var(--fg-muted);
  }

  /* ═══════════════════════════════════════════════════════════════
     BADGES
     ═══════════════════════════════════════════════════════════════ */

  .badge {
    font-size: 10px;
    font-family: var(--font-mono);
    padding: 2px 8px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    font-weight: 700;
  }
  .badge-active { background: oklch(0.723 0.191 149 / 0.15); color: oklch(0.723 0.191 149); }
  .badge-yield { background: oklch(0.705 0.213 47.604 / 0.15); color: oklch(0.705 0.213 47.604); }
  .badge-charge { background: oklch(0.546 0.215 264 / 0.15); color: oklch(0.65 0.17 264); }
  .badge-off { background: oklch(0.5 0 0 / 0.15); color: var(--fg-muted); }
  .badge-maint { background: oklch(0.68 0.22 300 / 0.15); color: oklch(0.68 0.22 300); }
  .badge-critical { background: oklch(0.467 0.186 18.5 / 0.15); color: oklch(0.60 0.17 18.5); }
  .badge-high { background: oklch(0.705 0.213 47.604 / 0.15); color: oklch(0.705 0.213 47.604); }
  .badge-normal { background: oklch(0.546 0.215 264 / 0.15); color: oklch(0.65 0.17 264); }
  .badge-low { background: oklch(0.5 0 0 / 0.10); color: var(--fg-muted); }
  .badge-cat { background: var(--surface); color: var(--fg-muted); border: 1px solid var(--border); }

  /* ═══════════════════════════════════════════════════════════════
     STATUS INDICATORS
     ═══════════════════════════════════════════════════════════════ */

  .status { display: flex; align-items: center; gap: 8px; font-size: 12px; }
  .status-icon { width: 8px; height: 8px; }
  .status-complete { background: oklch(0.723 0.191 149); }
  .status-active { background: oklch(0.705 0.213 47.604); animation: pulse 2s ease-in-out infinite; }
  .status-pending { background: var(--fg-muted); }
  .status-error { background: oklch(0.467 0.186 18.5); animation: pulse 1s ease-in-out infinite; }
  .status-offline { border: 1px solid var(--fg-muted); background: transparent; }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

  .status-inline { display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--fg-muted); }
  .status-dot { width: 6px; height: 6px; display: inline-block; }
  .dot-green { background: oklch(0.723 0.191 149); }
  .dot-orange { background: oklch(0.705 0.213 47.604); }
  .dot-red { background: oklch(0.467 0.186 18.5); }
  .dot-blue { background: oklch(0.546 0.215 264); }
