  .progress-value { min-width: 36px; text-align: right; font-variant-numeric: tabular-nums; }

  .sparkline-group { display: flex; flex-direction: column; gap: 16px; width: 100%; }
  .sparkline-item { display: flex; align-items: center; gap: 16px; }
  .sparkline-label { font-size: 10px; color: var(--fg-muted); min-width: 80px; text-transform: uppercase; letter-spacing: 0.04em; }
  .sparkline { width: 120px; height: 32px; flex-shrink: 0; }
  .sparkline-val { font-size: 13px; font-weight: 700; font-variant-numeric: tabular-nums; }

  /* ═══════════════════════════════════════════════════════════════
     CARDS
     ═══════════════════════════════════════════════════════════════ */

  .card { border: 1px solid var(--border); width: 320px; }
  .card-header { padding: 12px 16px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
  .card-title { font-size: 13px; font-weight: 700; }
  .card-badge { font-size: 10px; padding: 2px 8px; letter-spacing: 0.02em; }
  .card-badge-active { background: oklch(0.723 0.191 149 / 0.15); color: oklch(0.723 0.191 149); }
  .card-body { padding: 12px 16px; }
  .card-row { display: flex; justify-content: space-between; padding: 4px 0; font-size: 12px; }
  .card-label { color: var(--fg-muted); }

  .metric-card { border: 1px solid var(--border); padding: 16px; width: 220px; }
  .metric-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px; }
  .metric-label { font-size: 10px; color: var(--fg-muted); text-transform: uppercase; letter-spacing: 0.04em; }
  .metric-trend { font-size: 10px; font-weight: 700; }
  .trend-up { color: oklch(0.723 0.191 149); }
  .trend-down { color: oklch(0.723 0.191 149); }
  .metric-value { font-size: 28px; font-weight: 700; display: block; margin-bottom: 8px; font-variant-numeric: tabular-nums; }
  .metric-bar { display: flex; height: 4px; gap: 2px; }
  .metric-seg { height: 100%; }
  .metric-card .sparkline { width: 100%; height: 24px; }

  /* ═══════════════════════════════════════════════════════════════
     DATA DISPLAY
     ═══════════════════════════════════════════════════════════════ */

  .data-table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .data-table th { text-align: left; font-weight: 700; font-size: 10px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--fg-muted); padding: 8px 12px; border-bottom: 1px solid var(--border); }
  .data-table td { padding: 8px 12px; border-bottom: 1px solid var(--border); }
  .data-table tr:last-child td { border-bottom: none; }
  .inline-status { display: inline-block; width: 6px; height: 6px; margin-right: 4px; vertical-align: middle; }
  .inline-status.active { background: oklch(0.723 0.191 149); }
  .inline-status.yield { background: oklch(0.705 0.213 47.604); }
  .inline-status.offline { border: 1px solid var(--fg-muted); }

  .kv-list { width: 320px; border: 1px solid var(--border); }
  .kv-row { display: flex; justify-content: space-between; padding: 8px 16px; font-size: 12px; border-bottom: 1px solid var(--border); }
  .kv-row:last-child { border-bottom: none; }
  .kv-key { color: var(--fg-muted); font-size: 10px; text-transform: uppercase; letter-spacing: 0.04em; }
  .kv-val { font-variant-numeric: tabular-nums; }

  /* ═══════════════════════════════════════════════════════════════
     TIMELINE
     ═══════════════════════════════════════════════════════════════ */

  .timeline { display: flex; flex-direction: column; width: 100%; }
  .tl-entry { display: flex; align-items: flex-start; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--border); }
  .tl-entry:last-child { border-bottom: none; }
  .tl-time { font-size: 10px; color: var(--fg-muted); min-width: 36px; padding-top: 2px; font-variant-numeric: tabular-nums; }
  .tl-dot { width: 6px; height: 6px; margin-top: 5px; flex-shrink: 0; }
  .tl-dot-green { background: oklch(0.723 0.191 149); }
  .tl-dot-orange { background: oklch(0.705 0.213 47.604); }
  .tl-dot-red { background: oklch(0.467 0.186 18.5); }
  .tl-dot-blue { background: oklch(0.546 0.215 264); }
  .tl-content { display: flex; flex-direction: column; gap: 2px; }
  .tl-msg { font-size: 12px; }
  .tl-meta { font-size: 10px; color: var(--fg-muted); }

  /* ═══════════════════════════════════════════════════════════════
     CALLOUTS
     ═══════════════════════════════════════════════════════════════ */

  .callouts { display: flex; flex-direction: column; gap: 12px; width: 100%; }
  .callout { padding: 16px; border-left: 3px solid; font-size: 12px; line-height: 1.5; }
  .callout-title { font-weight: 700; margin-bottom: 4px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; }
  .callout p { color: var(--fg-muted); }
  .callout-danger { border-color: oklch(0.467 0.186 18.5); background: oklch(0.467 0.186 18.5 / 0.08); }
  .callout-danger .callout-title { color: oklch(0.60 0.17 18.5); }
  .callout-warning { border-color: oklch(0.705 0.213 47.604); background: oklch(0.705 0.213 47.604 / 0.08); }
  .callout-warning .callout-title { color: oklch(0.705 0.213 47.604); }
  .callout-info { border-color: oklch(0.546 0.215 264); background: oklch(0.546 0.215 264 / 0.08); }
  .callout-info .callout-title { color: oklch(0.65 0.17 264); }
  .callout-success { border-color: oklch(0.723 0.191 149); background: oklch(0.723 0.191 149 / 0.08); }
  .callout-success .callout-title { color: oklch(0.723 0.191 149); }

  /* ═══════════════════════════════════════════════════════════════
     TOASTS
     ═══════════════════════════════════════════════════════════════ */

  .toast-stack { display: flex; flex-direction: column; gap: 8px; width: 100%; max-width: 480px; }
  .toast { display: flex; align-items: center; gap: 10px; padding: 10px 14px; font-size: 12px; border: 1px solid var(--border); }
  .toast-icon { width: 18px; height: 18px; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 700; flex-shrink: 0; }
  .toast-msg { flex: 1; }
  .toast-close { background: none; border: none; color: var(--fg-muted); cursor: pointer; font-size: 14px; padding: 0 2px; }
  .toast-close:hover { color: var(--fg); }
  .toast-success .toast-icon { background: oklch(0.723 0.191 149 / 0.15); color: oklch(0.723 0.191 149); }
  .toast-warning .toast-icon { background: oklch(0.705 0.213 47.604 / 0.15); color: oklch(0.705 0.213 47.604); }
  .toast-error .toast-icon { background: oklch(0.467 0.186 18.5 / 0.15); color: oklch(0.60 0.17 18.5); }
  .toast-info .toast-icon { background: oklch(0.546 0.215 264 / 0.15); color: oklch(0.65 0.17 264); }

  /* ═══════════════════════════════════════════════════════════════
     MODAL
     ═══════════════════════════════════════════════════════════════ */

  .modal-demo { position: relative; width: 400px; }
  .modal-box { border: 1px solid var(--border); background: var(--bg); }
  .modal-header { padding: 16px 20px; border-bottom: 1px solid var(--border); font-size: 14px; font-weight: 700; }
  .modal-body { padding: 20px; font-size: 12px; line-height: 1.5; color: var(--fg-muted); }
  .modal-body strong { color: var(--fg); }
  .modal-list { margin: 8px 0 0 16px; list-style: disc; }
  .modal-list li { padding: 2px 0; }
  .modal-footer { padding: 12px 20px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: 8px; }

  /* ═══════════════════════════════════════════════════════════════
     INPUTS
     ═══════════════════════════════════════════════════════════════ */

  .form-group { display: flex; flex-direction: column; gap: 4px; }
  .form-label { font-size: 10px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--fg-muted); }
  .form-input { font-family: var(--font-mono); font-size: 13px; padding: 8px 12px; background: var(--surface); border: 1px solid var(--border); color: var(--fg); outline: none; transition: border-color 100ms ease; }
  .form-input:focus { border-color: var(--primary); }
  .form-input::placeholder { color: var(--fg-muted); }

  /* Toggle */
  .toggle { display: flex; align-items: center; gap: 10px; cursor: pointer; font-size: 12px; }
  .toggle input { display: none; }
  .toggle-track { width: 32px; height: 16px; background: var(--border); position: relative; transition: background-color 150ms ease; flex-shrink: 0; }
  .toggle-thumb { position: absolute; top: 2px; left: 2px; width: 12px; height: 12px; background: var(--fg-muted); transition: transform 150ms ease, background-color 150ms ease; }
  .toggle input:checked + .toggle-track { background: oklch(0.723 0.191 149 / 0.3); }
  .toggle input:checked + .toggle-track .toggle-thumb { transform: translateX(16px); background: oklch(0.723 0.191 149); }
  .toggle-text { color: var(--fg-muted); }

  /* Checkbox & Radio */
  .check-group { display: flex; flex-direction: column; gap: 8px; }
  .check { display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 12px; }
  .check input { display: none; }
  .check-box { width: 14px; height: 14px; border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: border-color 150ms ease, background-color 150ms ease; }
  .check input:checked + .check-box { background: var(--primary); border-color: var(--primary); }
  .check input:checked + .check-box::after { content: "✓"; font-size: 9px; color: var(--black); font-weight: 700; }
  .radio-dot { width: 14px; height: 14px; border: 1px solid var(--border); border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: border-color 150ms ease; }
  .check input:checked + .radio-dot { border-color: var(--primary); }
  .check input:checked + .radio-dot::after { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--primary); }

  /* Slider */
  .slider-group { display: flex; flex-direction: column; gap: 16px; width: 280px; }
  .slider-wrap { display: flex; align-items: center; gap: 12px; }
  .slider { flex: 1; -webkit-appearance: none; appearance: none; height: 4px; background: var(--border); outline: none; }
  .slider::-webkit-slider-thumb { -webkit-appearance: none; width: 14px; height: 14px; background: var(--primary); cursor: pointer; }
  .slider::-moz-range-thumb { width: 14px; height: 14px; background: var(--primary); border: none; cursor: pointer; }
  .slider-val { font-size: 12px; min-width: 48px; text-align: right; font-variant-numeric: tabular-nums; }

  /* ═══════════════════════════════════════════════════════════════
     NAVIGATION
     ═══════════════════════════════════════════════════════════════ */

  .tab-bar { display: flex; gap: 2px; border-bottom: 1px solid var(--border); }
  .tab { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase; padding: 8px 14px; background: none; border: none; color: var(--fg-muted); cursor: pointer; transition: color 100ms ease, background-color 100ms ease; border-bottom: 2px solid transparent; margin-bottom: -1px; }
  .tab:hover { color: var(--fg); background: var(--surface); }
  .tab-active { color: var(--fg); border-bottom-color: var(--primary); }

  .breadcrumb { display: flex; align-items: center; gap: 6px; font-size: 12px; }
  .crumb { color: var(--fg-muted); }
  .crumb:hover { color: var(--primary); }
  .crumb-current { color: var(--fg); }
  .crumb-sep { color: oklch(0.3 0 0); }

  .pagination { display: flex; gap: 2px; }
  .page-btn { font-family: var(--font-mono); font-size: 12px; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; background: none; border: 1px solid var(--border); color: var(--fg-muted); cursor: pointer; transition: all 100ms ease; }
  .page-btn:hover:not(:disabled) { border-color: var(--fg); color: var(--fg); }
  .page-btn:disabled { opacity: 0.3; cursor: not-allowed; }
  .page-active { background: var(--primary); color: var(--black); border-color: var(--primary); }
  .page-dots { display: flex; align-items: center; justify-content: center; width: 32px; font-size: 12px; color: var(--fg-muted); }

  /* ═══════════════════════════════════════════════════════════════
     KEYBOARD SHORTCUTS
     ═══════════════════════════════════════════════════════════════ */

  .kbd-list { display: flex; flex-direction: column; width: 100%; }
  .kbd-row { display: flex; align-items: center; gap: 16px; padding: 8px 0; border-bottom: 1px solid var(--border); }
  .kbd-row:last-child { border-bottom: none; }
  .kbd-combo { display: flex; align-items: center; gap: 4px; min-width: 120px; }
  kbd { font-family: var(--font-mono); font-size: 11px; padding: 2px 6px; background: var(--surface); border: 1px solid var(--border); color: var(--fg); min-width: 20px; text-align: center; }
  .kbd-desc { font-size: 12px; color: var(--fg-muted); }

  /* ═══════════════════════════════════════════════════════════════
     LOADING & EMPTY STATES
     ═══════════════════════════════════════════════════════════════ */

  .spinner { width: 20px; height: 20px; border: 2px solid var(--border); border-top-color: var(--primary); border-radius: 50%; animation: spin 0.8s linear infinite; }
  .spin-sm { width: 14px; height: 14px; }
  .spin-lg { width: 28px; height: 28px; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .skeleton-group { display: flex; flex-direction: column; gap: 10px; width: 300px; }
  .skeleton { background: var(--surface); animation: shimmer 1.5s ease-in-out infinite; }
  .skel-line { height: 12px; width: 100%; }
  .skel-block { height: 64px; width: 100%; }
  @keyframes shimmer { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }

  .empty-state { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 48px 24px; text-align: center; border: 1px dashed var(--border); width: 100%; }
  .empty-icon { font-size: 24px; color: var(--fg-muted); }
  .empty-title { font-size: 14px; font-weight: 700; }
  .empty-desc { font-size: 12px; color: var(--fg-muted); max-width: 320px; line-height: 1.5; }
  .empty-error .empty-icon { color: oklch(0.60 0.17 18.5); }
  .empty-error { border-color: oklch(0.467 0.186 18.5 / 0.3); }

  /* ═══════════════════════════════════════════════════════════════
