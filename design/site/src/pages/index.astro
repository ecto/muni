---
import Base from "../layouts/Base.astro";
---

<Base title="Design System">
  <div class="hero dot-grid">
    <p class="overline">Design System</p>
    <h1 class="title">Municipal<br />Robotics</h1>
    <p class="subtitle">
      A design language for machines that serve people.
      Terminal-native. High contrast. Safety orange.
    </p>
  </div>

  <section class="principles">
    <h2 class="section-title">Principles</h2>
    <div class="grid">
      <div class="card">
        <h3>People &gt; Task</h3>
        <p>
          The robot yields to people, always. The interface yields to the
          operator, always. Design for the human in the loop.
        </p>
      </div>
      <div class="card">
        <h3>Terminal Aesthetic</h3>
        <p>
          Monospace-first. High information density. Functional beauty emerges
          from precision, not ornament. Berkeley Mono is the voice.
        </p>
      </div>
      <div class="card">
        <h3>Sparse Emphasis</h3>
        <p>
          One accent color: safety orange. Boxes are reserved for danger zones
          and critical actions. If everything is loud, nothing is.
        </p>
      </div>
      <div class="card">
        <h3>Friendly Neighbor</h3>
        <p>
          These are not scary robots. They're neighbors — small, slow, polite,
          and a little charming. The design should make a kid wave, not flinch.
        </p>
      </div>
      <div class="card">
        <h3>Quiet Competence</h3>
        <p>
          No chrome, no gradients, no decorative motion. The system communicates
          through contrast, structure, and restraint.
        </p>
      </div>
      <div class="card">
        <h3>Civic Identity</h3>
        <p>
          This is public infrastructure, not a consumer product. The design
          signals service, transparency, and accountability.
        </p>
      </div>
      <div class="card">
        <h3>Cross-Platform</h3>
        <p>
          One token set feeds web, print, and physical robot livery. Change a
          color once, it propagates everywhere.
        </p>
      </div>
    </div>
  </section>

  <section class="anatomy">
    <h2 class="section-title">Anatomy</h2>
    <div class="stack">
      <div class="layer">
        <div class="layer-label" style="color: oklch(0.705 0.213 47.604)">Tokens</div>
        <div class="layer-desc">
          Color, typography, spacing, motion, breakpoints — defined in
          TypeScript, built to CSS, Tailwind, and Typst
        </div>
      </div>
      <div class="layer">
        <div class="layer-label" style="color: oklch(0.75 0.20 195)">Components</div>
        <div class="layer-desc">
          React primitives wrapping shadcn/ui with muni tokens. Buttons, cards,
          status indicators, data tables.
        </div>
      </div>
      <div class="layer">
        <div class="layer-label" style="color: oklch(0.68 0.22 300)">Patterns</div>
        <div class="layer-desc">
          Layout compositions, navigation, status dashboards, map overlays,
          teleoperation views.
        </div>
      </div>
      <div class="layer">
        <div class="layer-label" style="color: oklch(0.72 0.21 25)">Surfaces</div>
        <div class="layer-desc">
          Depot console, public website, technical manuals, datasheets, robot
          display panel.
        </div>
      </div>
    </div>
  </section>

  <section class="fonts-preview">
    <h2 class="section-title">Two Fonts</h2>
    <div class="font-pair">
      <div class="font-block">
        <p class="font-label">Display — Space Grotesk</p>
        <p class="font-display">
          Sidewalk<br />Service Robot
        </p>
      </div>
      <div class="font-block">
        <p class="font-label">System — Berkeley Mono</p>
        <p class="font-mono">
          status: operational<br />
          unit_id: beaver-12<br />
          task: clearing snow
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    padding: 96px 0;
    margin-bottom: 96px;
  }
  .overline {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: 24px;
  }
  .title {
    font-family: var(--font-display);
    font-size: clamp(48px, 10vw, 80px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    margin-bottom: 24px;
  }
  .subtitle {
    font-size: 16px;
    color: var(--fg-muted);
    max-width: 480px;
    line-height: 1.5;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }
  .card {
    padding: 20px;
    background: var(--bg);
  }
  .card h3 {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .card p {
    font-size: 12px;
    color: var(--fg-muted);
    line-height: 1.5;
  }

  /* Anatomy */
  .anatomy {
    margin-bottom: 96px;
  }
  .stack {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
  }
  .layer {
    display: flex;
    gap: 32px;
    padding: 20px 24px;
    border-bottom: 1px solid var(--border);
    align-items: baseline;
  }
  .layer:last-child {
    border-bottom: none;
  }
  .layer-label {
    font-size: 12px;
    font-weight: 700;
    min-width: 120px;
    color: var(--primary);
  }
  .layer-desc {
    font-size: 12px;
    color: var(--fg-muted);
    line-height: 1.5;
  }

  /* Fonts preview */
  .fonts-preview {
    margin-bottom: 96px;
  }
  .font-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }
  .font-block {
    padding: 48px 32px;
    background: var(--bg);
  }
  .font-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-bottom: 24px;
  }
  .font-display {
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .font-mono {
    font-family: var(--font-mono);
    font-size: 18px;
    line-height: 1.6;
    color: var(--fg);
  }

  @media (max-width: 768px) {
    .font-pair {
      grid-template-columns: 1fr;
    }
    .layer {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
