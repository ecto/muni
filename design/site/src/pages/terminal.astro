<script>
  // Clock
  function tick() {
    const hero = document.getElementById('hero-clock');
    if (hero) {
      const now = new Date();
      hero.textContent = now.toLocaleTimeString('en-US', {
        hour12: false, hour: '2-digit', minute: '2-digit'
      });
    }
  }
  tick();
  setInterval(tick, 1000);

  // Spinner
  const frames = ['⠋','⠙','⠹','⠸','⠼','⠴','⠦','⠧','⠇','⠏'];
  let frame = 0;
  const spinner = document.getElementById('spinner');
  if (spinner) {
    setInterval(() => {
      frame = (frame + 1) % frames.length;
      spinner.textContent = frames[frame];
    }, 80);
  }
</script>

<style>
  /* ═══ Terminal window chrome ═══ */

  .term-window {
    border: 1px solid var(--border);
    overflow: hidden;
    margin-bottom: 16px;
  }
  .term-chrome {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 32px;
    padding: 0 12px;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .term-dots {
    display: flex;
    gap: 6px;
  }
  .term-dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: oklch(0.3 0 0);
  }
  .term-dots span:first-child { background: oklch(0.637 0.237 25 / 0.7); }
  .term-dots span:nth-child(2) { background: oklch(0.85 0.18 85 / 0.7); }
  .term-dots span:last-child { background: oklch(0.723 0.191 149 / 0.7); }
  .term-win-title {
    font-size: 10px;
    color: var(--fg-muted);
    letter-spacing: 0.02em;
  }

  /* ═══ Terminal body (shared) ═══ */

  .term-body {
    padding: 20px 24px;
    font-size: 13px;
    line-height: 1.55;
    overflow-x: auto;
    background: oklch(0.03 0 0);
    margin: 0;
    white-space: pre;
    scrollbar-width: thin;
  }
  .hero-term {
    font-size: 12.5px;
    line-height: 1.5;
  }

  /* ═══ Terminal colors ═══ */

  .c-red { color: oklch(0.637 0.237 25); }
  .c-green { color: oklch(0.723 0.191 149); }
  .c-yellow { color: oklch(0.85 0.18 85); }
  .c-blue { color: oklch(0.546 0.215 264); }
  .c-magenta { color: oklch(0.68 0.22 300); }
  .c-cyan { color: oklch(0.75 0.15 195); }
  .c-orange { color: oklch(0.705 0.213 47.604); }
  .c-muted { color: oklch(0.45 0 0); }
  .c-bold { font-weight: 700; }

  .c-swatch-black { color: oklch(0.15 0 0); }
  .c-swatch-red { color: oklch(0.637 0.237 25); }
  .c-swatch-green { color: oklch(0.723 0.191 149); }
  .c-swatch-yellow { color: oklch(0.85 0.18 85); }
  .c-swatch-blue { color: oklch(0.546 0.215 264); }
  .c-swatch-magenta { color: oklch(0.68 0.22 300); }
  .c-swatch-cyan { color: oklch(0.75 0.15 195); }
  .c-swatch-white { color: oklch(0.90 0 0); }
  .c-swatch-orange { color: oklch(0.705 0.213 47.604); }

  /* ═══ Sections ═══ */

  section { margin-bottom: 120px; }
  .section-head { margin-bottom: 48px; }
  .section-num {
    font-size: 10px;
    color: var(--primary);
    letter-spacing: 0.08em;
